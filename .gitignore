# KiCad per-user settings and editor locks
*.kicad_prl
*.lck

# KiCad automatic backups and autosaves
*-backups/
_autosave-*
*.bak
*.bck
*.kicad_sch~
*.kicad_pcb~
.history/

# Windows Explorer metadata
Thumbs.db
Desktop.ini

# Local FreeCAD view copies and automatic backups
*.FCBak
/mechanical/display-fit-view.FCStd
/mechanical/display-fit-view.png
/mechanical/mini_handheld.FCStd
/mechanical/mini_handheld.png
/mechanical/mini_handheld-high-resolution.stl
